#!/bin/bash
# Convert all PNG images to WebP and AVIF during build
# Output goes to static/ for Hugo to copy to public/

set -euo pipefail

IMAGES_DIR="static/images"
WEBP_QUALITY="${WEBP_QUALITY:-82}"
AVIF_QUALITY="${AVIF_QUALITY:-56}"
JOBS="${JOBS:-$(( ($(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)) * 2 ))}"

# Large images that need responsive srcset variants (width in px)
# Format: "path/to/image.png:w1,w2,w3"
RESPONSIVE_IMAGES=(
  "static/images/natalia.png:640,960,1200,1600"
)

if [ ! -d "$IMAGES_DIR" ]; then
  echo "Images directory not found: $IMAGES_DIR"
  exit 1
fi

if ! command -v cwebp >/dev/null 2>&1; then
  echo "Error: cwebp is not installed or not in PATH." >&2
  exit 127
fi

if ! command -v avifenc >/dev/null 2>&1; then
  echo "Error: avifenc is not installed or not in PATH." >&2
  exit 127
fi

echo "Converting missing WebP/AVIF files from PNG assets..."

png_count=$(find "$IMAGES_DIR" -name "*.png" | wc -l)
if [ "$png_count" -eq 0 ]; then
  exit 0
fi

# Convert to WebP and AVIF in parallel using xargs
# Both formats are processed concurrently for each image
file_sha256() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  else
    shasum -a 256 "$file" | awk '{print $1}'
  fi
}

source_signature() {
  local png="$1"
  local src_hash
  src_hash="$(file_sha256 "$png")"
  printf '%s|webp:%s|avif:%s\n' "$src_hash" "$WEBP_QUALITY" "$AVIF_QUALITY"
}

needs_regeneration() {
  local output="$1"
  local stamp_file="$2"
  local expected_signature="$3"

  if [ ! -f "$output" ] || [ ! -f "$stamp_file" ]; then
    return 0
  fi

  local current_signature
  current_signature="$(cat "$stamp_file" 2>/dev/null || true)"
  if [ "$current_signature" != "$expected_signature" ]; then
    return 0
  fi

  return 1
}

convert_one() {
  local png="$1"
  local webp="${png%.png}.webp"
  local avif="${png%.png}.avif"
  local signature
  local webp_stamp
  local avif_stamp
  signature="$(source_signature "$png")"
  webp_stamp="${webp}.srcsha"
  avif_stamp="${avif}.srcsha"

  if needs_regeneration "$webp" "$webp_stamp" "$signature"; then
    cwebp -q "$WEBP_QUALITY" "$png" -o "$webp" 2>/dev/null || true
    printf '%s\n' "$signature" > "$webp_stamp"
  fi
  if needs_regeneration "$avif" "$avif_stamp" "$signature"; then
    avifenc -s 4 -c aom -q "$AVIF_QUALITY" "$png" "$avif" 2>/dev/null || true
    printf '%s\n' "$signature" > "$avif_stamp"
  fi
}

export -f convert_one
export -f file_sha256 source_signature needs_regeneration
export WEBP_QUALITY AVIF_QUALITY

find "$IMAGES_DIR" -name "*.png" | xargs -P "$JOBS" -I{} bash -c 'convert_one "$@"' _ {}

# Generate responsive srcset variants for large images
if command -v cwebp >/dev/null 2>&1 && command -v avifenc >/dev/null 2>&1; then
  for entry in "${RESPONSIVE_IMAGES[@]}"; do
    png="${entry%%:*}"
    widths="${entry##*:}"
    if [ ! -f "$png" ]; then continue; fi
    IFS=',' read -ra width_list <<< "$widths"
    for w in "${width_list[@]}"; do
      stem="${png%.png}"
      webp_out="${stem}-${w}.webp"
      avif_out="${stem}-${w}.avif"
      signature="$(source_signature "$png")|w:${w}"
      webp_stamp="${webp_out}.srcsha"
      avif_stamp="${avif_out}.srcsha"

      if needs_regeneration "$webp_out" "$webp_stamp" "$signature"; then
        cwebp -q "$WEBP_QUALITY" -resize "$w" 0 "$png" -o "$webp_out" 2>/dev/null || true
        printf '%s\n' "$signature" > "$webp_stamp"
      fi
      if needs_regeneration "$avif_out" "$avif_stamp" "$signature"; then
        avifenc -s 4 -c aom -q "$AVIF_QUALITY" --target-size "$w" 0 "$png" "$avif_out" 2>/dev/null || \
        avifenc -s 4 -c aom -q "$AVIF_QUALITY" "$png" "$avif_out" 2>/dev/null || true
        printf '%s\n' "$signature" > "$avif_stamp"
      fi
    done
  done
fi

webp_final=$(find "$IMAGES_DIR" -name "*.webp" | wc -l)
avif_final=$(find "$IMAGES_DIR" -name "*.avif" | wc -l)

