#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const yaml = require("js-yaml");

const rootDir = process.cwd();
const sourceDir = path.join(rootDir, "content", "de", "glossar");
const outputDir = path.join(rootDir, "artifact-local", "glossary-export");
const siteBaseUrl = "https://eskyna.com";
const defaultAuthor = "Natalia Kleemann";

function walk(dir) {
  if (!fs.existsSync(dir)) return [];

  const files = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const entryPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      files.push(...walk(entryPath));
      continue;
    }
    if (entry.isFile() && entry.name.endsWith(".md")) files.push(entryPath);
  }

  return files;
}

function splitFrontmatter(text) {
  const match = text.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  if (!match) return { fm: "", body: text };
  return { fm: match[1], body: match[2] };
}

function parseFrontmatter(text, filePath) {
  const { fm, body } = splitFrontmatter(text);
  let data = {};

  if (fm.trim()) {
    try {
      const parsed = yaml.load(fm);
      if (parsed && typeof parsed === "object") data = parsed;
    } catch (error) {
      throw new Error(`Failed to parse frontmatter in ${filePath}: ${error.message}`);
    }
  }

  return { fm: data, body };
}

function asArray(value) {
  if (!value) return [];
  if (Array.isArray(value)) return value.flatMap((item) => asArray(item));
  if (typeof value === "string") {
    const trimmed = value.trim();
    return trimmed ? [trimmed] : [];
  }
  if (typeof value === "object") {
    if (typeof value.title === "string") return [value.title.trim()].filter(Boolean);
    if (typeof value.name === "string") return [value.name.trim()].filter(Boolean);
  }
  return [];
}

function normalizeUrl(url) {
  if (!url) return "";
  const trimmed = String(url).trim();
  if (!trimmed) return "";
  if (/^https?:\/\//i.test(trimmed)) return trimmed;
  if (trimmed.startsWith("/")) return `${siteBaseUrl}${trimmed}`;
  return `${siteBaseUrl}/${trimmed.replace(/^\.\/?/, "")}`;
}

function absoluteGlossaryUrl(slug) {
  return `${siteBaseUrl}/glossar/${slug.replace(/^\/+|\/+$/g, "")}/`;
}

function extractInternalLinks(body) {
  const links = new Set();
  const pattern = /\[[^\]]*\]\(([^)]+)\)/g;
  let match = null;

  while ((match = pattern.exec(body)) !== null) {
    const href = match[1].split("#")[0].trim();
    if (!href) continue;
    if (/^(mailto:|tel:|javascript:)/i.test(href)) continue;
    if (/^https?:\/\//i.test(href)) {
      try {
        const parsed = new URL(href);
        if (parsed.hostname === "eskyna.com") links.add(parsed.href);
      } catch {
        continue;
      }
      continue;
    }
    if (href.startsWith("/")) {
      links.add(normalizeUrl(href));
      continue;
    }
    links.add(normalizeUrl(href));
  }

  return [...links].sort((a, b) => a.localeCompare(b, "de"));
}

function extractRelatedTerms(frontmatter) {
  const relatedTerms = [];
  if (!Array.isArray(frontmatter.relatedTerms)) return relatedTerms;

  for (const item of frontmatter.relatedTerms) {
    if (!item || typeof item !== "object") continue;
    const title = typeof item.title === "string" ? item.title.trim() : "";
    const url = normalizeUrl(item.url);
    if (!title && !url) continue;
    relatedTerms.push({ title, url });
  }

  return relatedTerms;
}

function toCsvCell(value) {
  const text = value === null || value === undefined ? "" : String(value);
  return `"${text.replace(/"/g, '""')}"`;
}

function joinList(values) {
  return values.filter(Boolean).join("; ");
}

function main() {
  const files = walk(sourceDir).filter((filePath) => path.basename(filePath) !== "_index.md");
  const entries = [];

  for (const filePath of files) {
    const text = fs.readFileSync(filePath, "utf8");
    const { fm, body } = parseFrontmatter(text, filePath);

    if (fm.is_glossar_index_helper || fm.is_glossar_category) continue;

    const term = String(fm.term || fm.title || "").trim();
    const slug = String(fm.slug || path.basename(filePath, ".md")).trim();
    if (!term || !slug) continue;

    const categories = asArray(fm.category || fm.categories);
    const synonyms = asArray(fm.synonyms || fm.aliases);
    const keywords = asArray(fm.keywords);
    const relatedTerms = extractRelatedTerms(fm);
    const internalLinks = extractInternalLinks(body);
    const lastmod = String(fm.lastmod || "").trim();
    const author = String(fm.author || fm.author_name || defaultAuthor).trim();
    const status = fm.draft === true || fm.draft === "true" ? "draft" : "published";

    entries.push({
      id: String(fm.id || slug).trim(),
      term,
      slug,
      url: absoluteGlossaryUrl(slug),
      status,
      categories,
      synonyms,
      keywords,
      author,
      updated_at: lastmod,
      image: normalizeUrl(fm.image),
      image_alt: String(fm.image_alt || "").trim(),
      related_terms: relatedTerms,
      internal_links: internalLinks,
      source_file: path.relative(rootDir, filePath).replace(/\\/g, "/"),
    });
  }

  entries.sort((left, right) => left.term.localeCompare(right.term, "de"));

  fs.mkdirSync(outputDir, { recursive: true });

  const exportData = {
    exported_at: new Date().toISOString(),
    source_directory: path.relative(rootDir, sourceDir).replace(/\\/g, "/"),
    total_entries: entries.length,
    entries,
  };

  fs.writeFileSync(
    path.join(outputDir, "glossary-export.json"),
    `${JSON.stringify(exportData, null, 2)}\n`
  );

  const csvHeaders = [
    "id",
    "term",
    "slug",
    "url",
    "status",
    "categories",
    "synonyms",
    "keywords",
    "author",
    "updated_at",
    "image",
    "image_alt",
    "related_terms",
    "internal_links",
    "source_file",
  ];

  const csvRows = [csvHeaders.map(toCsvCell).join(",")];
  for (const entry of entries) {
    const relatedTerms = entry.related_terms
      .map((item) => (item.url ? `${item.title} (${item.url})` : item.title))
      .filter(Boolean);
    csvRows.push(
      [
        entry.id,
        entry.term,
        entry.slug,
        entry.url,
        entry.status,
        joinList(entry.categories),
        joinList(entry.synonyms),
        joinList(entry.keywords),
        entry.author,
        entry.updated_at,
        entry.image,
        entry.image_alt,
        joinList(relatedTerms),
        joinList(entry.internal_links),
        entry.source_file,
      ]
        .map(toCsvCell)
        .join(",")
    );
  }

  fs.writeFileSync(path.join(outputDir, "glossary-export.csv"), `${csvRows.join("\n")}\n`);

  console.log(
    `Exported ${entries.length} glossary entries to ${path.relative(rootDir, outputDir)}`
  );
}

main();
