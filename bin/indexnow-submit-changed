#!/usr/bin/env node

const fs = require("fs");
const path = require("path");
const { execSync } = require("child_process");

const DEFAULT_BASE_URL = "https://eskyna.com/";
const DEFAULT_ENDPOINT = "https://api.indexnow.org/indexnow";
const DEFAULT_BATCH_SIZE = 10000;

function parseArgs(argv) {
  const args = {};
  for (let i = 0; i < argv.length; i += 1) {
    const token = argv[i];
    if (!token.startsWith("--")) continue;

    const key = token.slice(2);
    const next = argv[i + 1];
    if (!next || next.startsWith("--")) {
      args[key] = true;
      continue;
    }

    args[key] = next;
    i += 1;
  }
  return args;
}

function run(command) {
  return execSync(command, { encoding: "utf8" }).trim();
}

function toPosix(filePath) {
  return filePath.split(path.sep).join("/");
}

function stripQuotes(value) {
  return value.replace(/^['"]|['"]$/g, "");
}

function parseFrontmatter(content) {
  if (content.startsWith("---\n")) {
    const end = content.indexOf("\n---", 4);
    if (end === -1) return {};

    const block = content.slice(4, end).split("\n");
    const data = {};
    for (const line of block) {
      const match = line.match(/^([A-Za-z0-9_\-]+):\s*(.*)$/);
      if (!match) continue;
      data[match[1]] = stripQuotes((match[2] || "").trim());
    }
    return data;
  }

  if (content.startsWith("+++\n")) {
    const end = content.indexOf("\n+++", 4);
    if (end === -1) return {};

    const block = content.slice(4, end).split("\n");
    const data = {};
    for (const line of block) {
      const match = line.match(/^([A-Za-z0-9_\-]+)\s*=\s*(.*)$/);
      if (!match) continue;
      data[match[1]] = stripQuotes((match[2] || "").trim());
    }
    return data;
  }

  return {};
}

function parseSitemap(sitemapPath) {
  if (!fs.existsSync(sitemapPath)) return [];
  const xml = fs.readFileSync(sitemapPath, "utf8");
  const matches = [...xml.matchAll(/<loc>(.*?)<\/loc>/g)];
  return matches.map((m) => m[1].trim()).filter(Boolean);
}

function detectIndexNowKey(staticDir) {
  const entries = fs.readdirSync(staticDir, { withFileTypes: true });
  const candidates = [];

  for (const entry of entries) {
    if (!entry.isFile()) continue;
    if (!entry.name.endsWith(".txt")) continue;

    const basename = entry.name.slice(0, -4);
    if (!/^[A-Za-z0-9-]{8,128}$/.test(basename)) continue;

    const absolute = path.join(staticDir, entry.name);
    const content = fs.readFileSync(absolute, "utf8").trim();
    if (content === basename) {
      candidates.push(basename);
    }
  }

  if (candidates.length === 1) return candidates[0];
  if (candidates.length === 0) {
    throw new Error("Kein IndexNow-Key gefunden. Lege static/<key>.txt mit dem Key als Inhalt an.");
  }

  throw new Error(
    `Mehrere IndexNow-Key-Dateien gefunden (${candidates.join(", ")}). Bitte genau eine verwenden.`
  );
}

function parseChangedFiles(fromRef, toRef) {
  const output = run(`git diff --name-status --find-renames ${fromRef} ${toRef}`);
  const rows = output
    .split("\n")
    .map((line) => line.trim())
    .filter(Boolean);

  const changes = [];
  for (const row of rows) {
    const cols = row.split("\t");
    const status = cols[0];
    if (!status) continue;

    if (status.startsWith("R") || status.startsWith("C")) {
      if (cols[1]) changes.push({ status: "D", filePath: toPosix(cols[1]) });
      if (cols[2]) changes.push({ status: "A", filePath: toPosix(cols[2]) });
      continue;
    }

    if (cols[1]) {
      changes.push({ status: status[0], filePath: toPosix(cols[1]) });
    }
  }

  return changes;
}

function isGlobalChange(changes) {
  const globalPrefixes = [
    "layouts/",
    "assets/",
    "i18n/",
    "data/",
    "archetypes/",
    "static/css/",
    "static/js/",
  ];

  const globalFiles = new Set(["config.toml", "README.md"]);

  return changes.some((change) => {
    if (globalFiles.has(change.filePath)) return true;
    return globalPrefixes.some((prefix) => change.filePath.startsWith(prefix));
  });
}

function normalizePathname(pathname) {
  const withLeadingSlash = pathname.startsWith("/") ? pathname : `/${pathname}`;
  const squashed = withLeadingSlash.replace(/\/+/g, "/");
  if (squashed === "/") return "/";
  return squashed.endsWith("/") ? squashed : `${squashed}/`;
}

function mapContentPathToUrlPath(change) {
  const parts = change.filePath.split("/");
  if (parts.length < 3) return null;

  const langDir = parts[1];
  const relativeParts = parts.slice(2);
  const filename = relativeParts[relativeParts.length - 1] || "";
  if (!filename.endsWith(".md")) return null;

  const langPrefix =
    langDir === "de" ? "" : langDir === "en" ? "/en" : langDir === "ru" ? "/ru" : null;
  if (langPrefix === null) return null;

  let overridePath = "";
  if (change.status !== "D") {
    const abs = path.resolve(change.filePath);
    if (fs.existsSync(abs)) {
      const source = fs.readFileSync(abs, "utf8");
      const fm = parseFrontmatter(source);
      const explicit = fm.permalink || fm.url;
      if (explicit) {
        if (/^https?:\/\//i.test(explicit)) {
          try {
            overridePath = new URL(explicit).pathname;
          } catch (_) {
            overridePath = "";
          }
        } else {
          overridePath = explicit;
        }
      } else if (fm.slug) {
        const baseDir = relativeParts.slice(0, -1);
        overridePath = `/${baseDir.join("/")}/${fm.slug}/`;
      }
    }
  }

  if (overridePath) {
    const normalized = normalizePathname(overridePath);
    if (langPrefix && !normalized.startsWith(`${langPrefix}/`) && normalized !== langPrefix + "/") {
      return normalizePathname(`${langPrefix}${normalized}`);
    }
    return normalized;
  }

  const baseDir = relativeParts.slice(0, -1);
  const stem = filename.slice(0, -3);

  let localPath = "/";
  if (filename === "_index.md" || filename === "index.md") {
    localPath = baseDir.length === 0 ? "/" : `/${baseDir.join("/")}/`;
  } else {
    localPath = `/${baseDir.join("/")}/${stem}/`;
  }

  return normalizePathname(`${langPrefix}${localPath}`);
}

function mapStaticHtmlToUrlPath(change) {
  if (!change.filePath.startsWith("static/")) return null;
  if (!change.filePath.endsWith(".html")) return null;

  const relative = change.filePath.slice("static/".length);
  if (relative === "index.html") return "/";

  if (relative.endsWith("/index.html")) {
    return normalizePathname(relative.slice(0, -"index.html".length));
  }

  return `/${relative}`;
}

function mapChangesToUrls(changes, baseUrl) {
  const urls = new Set();
  const siteBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;

  for (const change of changes) {
    if (change.filePath.startsWith("content/")) {
      const pathname = mapContentPathToUrlPath(change);
      if (pathname) urls.add(`${siteBase}${pathname}`);
      continue;
    }

    const staticPathname = mapStaticHtmlToUrlPath(change);
    if (staticPathname) {
      urls.add(`${siteBase}${staticPathname}`);
    }
  }

  return [...urls];
}

function chunk(items, size) {
  const chunks = [];
  for (let i = 0; i < items.length; i += size) {
    chunks.push(items.slice(i, i + size));
  }
  return chunks;
}

async function submitToIndexNow({ endpoint, host, key, keyLocation, urls, batchSize }) {
  const batches = chunk(urls, batchSize);
  let failures = 0;

  for (let i = 0; i < batches.length; i += 1) {
    const payload = {
      host,
      key,
      keyLocation,
      urlList: batches[i],
    };

    const response = await fetch(endpoint, {
      method: "POST",
      headers: {
        "Content-Type": "application/json; charset=utf-8",
      },
      body: JSON.stringify(payload),
    });

    if (response.status === 200 || response.status === 202) {
      console.log(`Batch ${i + 1}/${batches.length}: akzeptiert (${response.status})`);
      continue;
    }

    const body = await response.text();
    console.error(`Batch ${i + 1}/${batches.length}: Fehler ${response.status} ${body}`);
    failures += 1;
  }

  return failures;
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  const baseUrl = args["base-url"] || DEFAULT_BASE_URL;
  const endpoint = args.endpoint || DEFAULT_ENDPOINT;
  const sitemapPath = args.sitemap || path.resolve("public/sitemap.xml");
  const staticDir = args["static-dir"] || path.resolve("static");
  const batchSize = Number(args["batch-size"] || DEFAULT_BATCH_SIZE);

  const toRef = args.to || process.env.GITHUB_SHA || "HEAD";
  let fromRef = args.from || process.env.GITHUB_EVENT_BEFORE || "";
  if (!fromRef || /^0+$/.test(fromRef)) {
    fromRef = run("git rev-parse HEAD~1");
  }

  const key = args.key || process.env.INDEXNOW_KEY || detectIndexNowKey(staticDir);
  const trimmedBase = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  const keyLocation = args["key-location"] || `${trimmedBase}/${key}.txt`;
  const host = new URL(trimmedBase).host;

  const changes = parseChangedFiles(fromRef, toRef);
  console.log(`Geaenderte Dateien: ${changes.length}`);

  let urls;
  if (args["all-from-sitemap"] || isGlobalChange(changes)) {
    urls = parseSitemap(sitemapPath);
    console.log(`Globaler Change erkannt. Verwende komplette Sitemap: ${urls.length} URLs.`);
  } else {
    urls = mapChangesToUrls(changes, trimmedBase);
    console.log(`Abgeleitete geaenderte URLs: ${urls.length}`);
  }

  if (urls.length === 0) {
    console.log("Keine passenden URLs fuer IndexNow gefunden. Ende.");
    return;
  }

  if (args["dry-run"]) {
    console.log("Dry run aktiv. Erste 50 URLs:");
    for (const url of urls.slice(0, 50)) {
      console.log(`- ${url}`);
    }
    return;
  }

  const failures = await submitToIndexNow({
    endpoint,
    host,
    key,
    keyLocation,
    urls,
    batchSize,
  });

  if (failures > 0) {
    process.exitCode = 1;
  }
}

main().catch((error) => {
  console.error(error.message || error);
  process.exit(1);
});
