{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $seen := newScratch -}}

  {{- range . -}}
    {{- $site := . -}}
    {{- $home := $site.Home -}}
    {{- if and $home (not ($seen.Get $home.Permalink)) -}}
      {{- $seen.Set $home.Permalink true -}}
      <url>
        <loc>{{ $home.Permalink }}</loc>
        {{- if not $home.Lastmod.IsZero -}}<lastmod>{{ $home.Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{- end -}}
        {{- range $home.AllTranslations -}}
          <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode | default .Language.Lang }}" href="{{ .Permalink }}" />
        {{- end -}}
      </url>
    {{- end -}}

    {{- range $site.RegularPages -}}
      {{- if not (or (.Params.noindex | default false) (.Params.sitemap.disable | default false)) -}}
        {{- if not ($seen.Get .Permalink) -}}
          {{- $seen.Set .Permalink true -}}
          <url>
            <loc>{{ .Permalink }}</loc>
            {{- if not .Lastmod.IsZero -}}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{- end -}}
            {{- range .AllTranslations -}}
              <xhtml:link rel="alternate" hreflang="{{ .Language.LanguageCode | default .Language.Lang }}" href="{{ .Permalink }}" />
            {{- end -}}
          </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
</urlset>