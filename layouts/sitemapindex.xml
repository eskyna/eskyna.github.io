{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- $seen := newScratch -}}

  {{- range . -}}
    {{- $site := . -}}
    {{- range $site.Pages -}}
      {{- $includeKind := or .IsHome (or (eq .Kind "section") (eq .Kind "page")) -}}
      {{- $isTagPath := hasPrefix .RelPermalink "/tags/" -}}
      {{- if and $includeKind (not $isTagPath) .Permalink (not (or (.Params.noindex | default false) (.Params.sitemap.disable | default false) .Sitemap.Disable)) -}}
        {{- if not ($seen.Get .Permalink) -}}
          {{- $seen.Set .Permalink true -}}
          <url>
            <loc>{{ .Permalink }}</loc>
            {{- if not .Lastmod.IsZero -}}<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{- end -}}
            {{- with .Sitemap.ChangeFreq -}}<changefreq>{{ . }}</changefreq>{{- end -}}
            {{- if ge .Sitemap.Priority 0.0 -}}<priority>{{ .Sitemap.Priority }}</priority>{{- end -}}
            {{- range .AllTranslations -}}
              {{- if not (or (.Params.noindex | default false) (.Params.sitemap.disable | default false) .Sitemap.Disable) -}}
                {{- $hrefLang := .Language.LanguageCode | default .Language.Lang -}}
                {{- if eq $hrefLang "rus" -}}{{- $hrefLang = "ru" -}}{{- end -}}
                <xhtml:link rel="alternate" hreflang="{{ $hrefLang }}" href="{{ .Permalink }}" />
              {{- end -}}
            {{- end -}}
          </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
</urlset>
